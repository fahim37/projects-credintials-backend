{
  "name": "project-management-backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && tsx watch --env-file=.env src/server.ts",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env --test src/tests/*.test.ts",
    "migrate:clients": "tsx --env-file=.env src/scripts/migrate-clients.ts",
    "seed:admin": "tsx --env-file=.env src/scripts/seed-admin.ts",
    "gen:key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\"",
    "rotate:keys": "tsx --env-file=.env src/scripts/rotate-keys.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "SCALEUP project credentials vault API",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^8.2.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20.6"
  }
}
