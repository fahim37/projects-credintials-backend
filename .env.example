NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/scaleup_pm?retryWrites=true&w=majority
CORS_ORIGINS=http://localhost:3000

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_NAME=pm_session

# npm run gen:key  ->  ENCRYPTION_KEYS=v1:<key>
# Back this key up somewhere safe. Losing it makes all stored credentials unreadable.
ENCRYPTION_KEYS=

# Gmail: smtp.gmail.com / 465 / SMTP_SECURE=true / an App Password (not your login password)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SCALEUP <no-reply@example.com>
OTP_TTL_MINUTES=10

# Used by: npm run seed:admin
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_EMPLOYEE_ID=ADMIN-001
